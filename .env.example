# ==========================================
# APP
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# DATABASE
# ==========================================
# Motor utilizado actualmente:
# mysql | postgres | mssql | oracle
DB_DIALECT=mysql

# ==========================================
# MYSQL
# ==========================================
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=
DB_MYSQL_NAME=ActivaFit

# ==========================================
# POSTGRESQL
# ==========================================
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5433
DB_POSTGRES_USERNAME=postgres
DB_POSTGRES_PASSWORD=
DB_POSTGRES_NAME=activa_fit_db

# ==========================================
# SQL SERVER
# ==========================================
DB_MSSQL_HOST=localhost
DB_MSSQL_PORT=1433
DB_MSSQL_USERNAME=sa
DB_MSSQL_PASSWORD=
DB_MSSQL_NAME=activa_fit_db

# ==========================================
# ORACLE
# ==========================================
DB_ORACLE_HOST=localhost
DB_ORACLE_PORT=1521
DB_ORACLE_USERNAME=system
DB_ORACLE_PASSWORD=
DB_ORACLE_NAME=activa_fit_db
DB_ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# ==========================================
# JWT
# ==========================================
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
